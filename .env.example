# Copy this file to .env and fill in the values for local development.
# Never commit real values. On Lovable Cloud these are injected automatically.

# Lovable Cloud backend (public/publishable values — safe for the browser)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Browser-exposed duplicates (must match the values above)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets — set via Project Settings → Secrets, never in client code
# SUPABASE_SERVICE_ROLE_KEY=   (bypasses row-level security; server functions only)
# LOVABLE_API_KEY=             (AI gateway key; server functions only)
